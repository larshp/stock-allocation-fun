          requested_quantity = '5.000'
          requested_unit     = 'BOX' )
        ( request_id         = 'REQ-HIGH2-UOM'
          material           = 'MAT-1'
          target_plant       = '9002'
          priority           = 10
          requested_quantity = '5.000'
          requested_unit     = 'BOX' ) )
