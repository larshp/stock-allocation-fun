INTERFACE zif_planned_order_read_repo PUBLIC.

  TYPES ty_order_number TYPE plaf-plnum.
  TYPES ty_order_numbers TYPE STANDARD TABLE OF ty_order_number
    WITH EMPTY KEY.
  TYPES:
    BEGIN OF ty_order_header,
      planned_order               TYPE plaf-plnum,
      material                    TYPE plaf-matnr,
      plant                       TYPE plaf-pwwrk,
      planning_plant              TYPE plaf-plwrk,
      creation_date               TYPE plaf-pertr,
      planned_order_user          TYPE plaf-puser,
      last_change_timestamp       TYPE plaf-pstmp,
      scheduled_start_date        TYPE plaf-gstrs,
      scheduled_start_time        TYPE plaf-gsuzs,
      scheduled_finish_date       TYPE plaf-gltrs,
      scheduled_finish_time       TYPE plaf-gluzs,
      start_date                  TYPE plaf-psttr,
      finish_date                 TYPE plaf-pedtr,
      quantity                    TYPE plaf-gsmng,
      order_unit                  TYPE plaf-meins,
      base_unit                   TYPE mara-meins,
      order_type                  TYPE plaf-paart,
      storage_location            TYPE plaf-lgort,
      procurement_indicator       TYPE plaf-beskz,
      special_procurement_type    TYPE plaf-sobes,
      mrp_controller              TYPE plaf-dispo,
      production_supervisor       TYPE plaf-plgrp,
      production_version          TYPE plaf-verid,
      mrp_area                    TYPE plaf-berid,
      account_assignment_category TYPE plaf-knttp,
      fixed_indicator             TYPE plaf-auffx,
      planning_scenario           TYPE plaf-plscn,
      special_stock_indicator     TYPE plaf-sobkz,
      sales_order                 TYPE plaf-kdauf,
      sales_order_item            TYPE plaf-kdpos,
      sales_order_schedule_line   TYPE plaf-kdein,
      unit_to_base_numerator      TYPE marm-umrez,
      unit_to_base_denominator    TYPE marm-umren,
    END OF ty_order_header.
  TYPES ty_order_headers TYPE STANDARD TABLE OF ty_order_header
    WITH EMPTY KEY.
  TYPES:
    BEGIN OF ty_order_selection,
      material                     TYPE plaf-matnr,
      plant                        TYPE plaf-pwwrk,
      filter_planning_plant        TYPE abap_bool,
      planning_plant               TYPE plaf-plwrk,
      creation_date_from           TYPE plaf-pertr,
      creation_date_to             TYPE plaf-pertr,
      last_change_timestamp_from   TYPE plaf-pstmp,
      last_change_timestamp_to     TYPE plaf-pstmp,
      filter_planned_order_user    TYPE abap_bool,
      planned_order_user           TYPE plaf-puser,
      filter_sales_order           TYPE abap_bool,
      sales_order                  TYPE plaf-kdauf,
      filter_sales_order_item      TYPE abap_bool,
      sales_order_item             TYPE plaf-kdpos,
      filter_sales_schedule_line   TYPE abap_bool,
      sales_order_schedule_line    TYPE plaf-kdein,
      filter_planning_scenario     TYPE abap_bool,
      planning_scenario            TYPE plaf-plscn,
      filter_order_type            TYPE abap_bool,
      order_type                   TYPE plaf-paart,
      filter_storage_location      TYPE abap_bool,
      storage_location             TYPE plaf-lgort,
      filter_procurement_indicator TYPE abap_bool,
      procurement_indicator        TYPE plaf-beskz,
      filter_special_proc_type     TYPE abap_bool,
      special_procurement_type     TYPE plaf-sobes,
      filter_order_unit            TYPE abap_bool,
      order_unit                   TYPE plaf-meins,
      positive_quantity_only       TYPE abap_bool,
      filter_quantity_from         TYPE abap_bool,
      quantity_from                TYPE plaf-gsmng,
      filter_quantity_to           TYPE abap_bool,
      quantity_to                  TYPE plaf-gsmng,
      filter_base_quantity_from    TYPE abap_bool,
      base_quantity_from           TYPE decfloat34,
      filter_base_quantity_to      TYPE abap_bool,
      base_quantity_to             TYPE decfloat34,
      filter_mrp_controller        TYPE abap_bool,
      mrp_controller               TYPE plaf-dispo,
      filter_production_supervisor TYPE abap_bool,
      production_supervisor        TYPE plaf-plgrp,
      filter_production_version    TYPE abap_bool,
      production_version           TYPE plaf-verid,
      filter_mrp_area              TYPE abap_bool,
      mrp_area                     TYPE plaf-berid,
      filter_account_category      TYPE abap_bool,
      account_assignment_category  TYPE plaf-knttp,
      filter_special_stock         TYPE abap_bool,
      special_stock_indicator      TYPE plaf-sobkz,
      filter_fixed_indicator       TYPE abap_bool,
      fixed_indicator              TYPE plaf-auffx,
      filter_start_date            TYPE abap_bool,
      start_date                   TYPE plaf-psttr,
      start_date_from              TYPE plaf-psttr,
      start_date_to                TYPE plaf-psttr,
      filter_scheduled_start_date  TYPE abap_bool,
      scheduled_start_date         TYPE plaf-gstrs,
      scheduled_start_date_from    TYPE plaf-gstrs,
      scheduled_start_date_to      TYPE plaf-gstrs,
      filter_scheduled_start_time  TYPE abap_bool,
      scheduled_start_time_from    TYPE plaf-gsuzs,
      scheduled_start_time_to      TYPE plaf-gsuzs,
      filter_scheduled_finish_date TYPE abap_bool,
      scheduled_finish_date        TYPE plaf-gltrs,
      scheduled_finish_date_from   TYPE plaf-gltrs,
      scheduled_finish_date_to     TYPE plaf-gltrs,
      filter_scheduled_finish_time TYPE abap_bool,
      scheduled_finish_time_from   TYPE plaf-gluzs,
      scheduled_finish_time_to     TYPE plaf-gluzs,
      finish_date_from             TYPE plaf-pedtr,
      finish_date_to               TYPE plaf-pedtr,
      after_finish_date            TYPE plaf-pedtr,
      after_planned_order          TYPE plaf-plnum,
      maximum_results              TYPE i,
    END OF ty_order_selection.

  METHODS read_orders
    IMPORTING
      it_planned_orders TYPE ty_order_numbers
    RETURNING
      VALUE(rt_orders)  TYPE ty_order_headers.

  METHODS read_orders_by_finish_window
    IMPORTING
      is_selection     TYPE ty_order_selection
    RETURNING
      VALUE(rt_orders) TYPE ty_order_headers.

ENDINTERFACE.
