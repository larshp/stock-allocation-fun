{
  "global": {
    "files": "/{src,sap-stubs}/**/*.*"
  },
  "dependencies": [
    {
      "url": "https://github.com/open-abap/open-abap-core",
      "folder": "/deps/open-abap-core",
      "files": "/src/**/*.*"
    }
  ],
  "syntax": {
    "version": "open-abap",
    "errorNamespace": "."
  },
  "rules": {
    "check_syntax": true,
    "modify_only_own_db_tables": {
      "exclude": ["src/.*\\.testclasses\\.abap"],
      "severity": "Error"
    },
    "parser_error": true,
    "unknown_types": true,
    "main_file_contents": true,
    "implement_methods": true,
    "whitespace_end": true
  }
}
