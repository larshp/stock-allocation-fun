          iv_date = is_header-posting_date ) <> abap_true
        OR zcl_date_validation=>is_valid_gregorian_date(
          iv_date = is_header-document_date ) <> abap_true.
      RAISE EXCEPTION TYPE zcx_invalid_goods_movement.
    ENDIF.
  ENDMETHOD.

