    cl_abap_unit_assert=>assert_equals(
      exp = abap_true
      act = lv_conflict_rejected ).
    cl_abap_unit_assert=>assert_equals(
      exp = 2
      act = lo_repository->get_read_count( ) ).
  ENDMETHOD.

