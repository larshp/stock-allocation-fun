  METHOD rejects_bad_batch_loc_rank.
    DATA(lo_repository) = NEW lcl_stock_repository_double( ).
    DATA(lo_uom_repository) = NEW lcl_stock_uom_repo_double( ).
    lo_uom_repository->set_conversion(
      iv_base_unit        = 'EA'
