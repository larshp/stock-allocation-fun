   </INCLUDES>
   <FUNCTIONS>
    <item>
     <FUNCNAME>Z_STOCK_ALLOC_PROMISE</FUNCNAME>
     <SHORT_TEXT>What a plant can promise of a material</SHORT_TEXT>
     <REMOTE_CALL>R</REMOTE_CALL>
     <IMPORT>
      <RSIMP>
       <PARAMETER>IV_MATNR</PARAMETER>
       <TYP>MARD-MATNR</TYP>
      </RSIMP>
      <RSIMP>
       <PARAMETER>IV_WERKS</PARAMETER>
       <TYP>MARD-WERKS</TYP>
      </RSIMP>
      <RSIMP>
       <PARAMETER>IV_QUANTITY</PARAMETER>
       <TYP>ZSTOCK_ALLOC_PROMISE-QUANTITY</TYP>
      </RSIMP>
      <RSIMP>
       <PARAMETER>IV_BY_DATE</PARAMETER>
       <OPTIONAL>X</OPTIONAL>
       <TYP>ZSTOCK_ALLOC_PROMISE-AVAIL_DATE</TYP>
      </RSIMP>
      <RSIMP>
       <PARAMETER>IV_LGORT</PARAMETER>
       <OPTIONAL>X</OPTIONAL>
       <TYP>MARD-LGORT</TYP>
      </RSIMP>
     </IMPORT>
     <EXPORT>
      <RSEXP>
       <PARAMETER>ES_PROMISE</PARAMETER>
       <TYP>ZSTOCK_ALLOC_PROMISE</TYP>
      </RSEXP>
      <RSEXP>
       <PARAMETER>ES_RETURN</PARAMETER>
       <TYP>BAPIRET2</TYP>
      </RSEXP>
     </EXPORT>
    </item>
    <item>
     <FUNCNAME>Z_STOCK_ALLOC_PROMISES</FUNCNAME>
     <SHORT_TEXT>What a plant can promise, line by line</SHORT_TEXT>
     <REMOTE_CALL>R</REMOTE_CALL>
     <TABLES>
      <RSTBL>
       <PARAMETER>IT_ASK</PARAMETER>
       <DBSTRUCT>ZSTOCK_ALLOC_ASK</DBSTRUCT>
      </RSTBL>
      <RSTBL>
       <PARAMETER>ET_ANSWER</PARAMETER>
       <DBSTRUCT>ZSTOCK_ALLOC_ANS</DBSTRUCT>
      </RSTBL>
     </TABLES>
    </item>
    <item>
     <FUNCNAME>Z_STOCK_ALLOC_RESULT</FUNCNAME>
     <SHORT_TEXT>What the last run gave one order</SHORT_TEXT>
     <IMPORT>
      <RSIMP>
       <PARAMETER>IV_WERKS</PARAMETER>
       <TYP>MARD-WERKS</TYP>
      </RSIMP>
      <RSIMP>
       <PARAMETER>IV_VBELN</PARAMETER>
       <OPTIONAL>X</OPTIONAL>
       <TYP>VBAP-VBELN</TYP>
      </RSIMP>
      <RSIMP>
       <PARAMETER>IV_POSNR</PARAMETER>
       <OPTIONAL>X</OPTIONAL>
       <TYP>VBAP-POSNR</TYP>
      </RSIMP>
      <RSIMP>
       <PARAMETER>IV_EBELN</PARAMETER>
       <OPTIONAL>X</OPTIONAL>
       <TYP>EKKO-EBELN</TYP>
      </RSIMP>
     </IMPORT>
     <EXPORT>
      <RSEXP>
       <PARAMETER>ET_LINE</PARAMETER>
       <TYP>ZCL_ALLOC_RESULT_API=&gt;TY_LINE_TAB</TYP>
      </RSEXP>
      <RSEXP>
       <PARAMETER>ES_RETURN</PARAMETER>
       <TYP>BAPIRET2</TYP>
      </RSEXP>
     </EXPORT>
    </item>
    <item>
     <FUNCNAME>Z_STOCK_ALLOC_ALTERNATIVES</FUNCNAME>
     <SHORT_TEXT>What else could be promised instead</SHORT_TEXT>
     <IMPORT>
      <RSIMP>
       <PARAMETER>IV_MATNR</PARAMETER>
       <TYP>MARD-MATNR</TYP>
      </RSIMP>
      <RSIMP>
       <PARAMETER>IV_WERKS</PARAMETER>
       <TYP>MARD-WERKS</TYP>
      </RSIMP>
      <RSIMP>
       <PARAMETER>IV_QUANTITY</PARAMETER>
       <TYP>ZSTOCK_ALLOC_PROMISE-QUANTITY</TYP>
      </RSIMP>
      <RSIMP>
       <PARAMETER>IV_BY_DATE</PARAMETER>
       <OPTIONAL>X</OPTIONAL>
       <TYP>ZSTOCK_ALLOC_PROMISE-AVAIL_DATE</TYP>
      </RSIMP>
     </IMPORT>
     <EXPORT>
      <RSEXP>
       <PARAMETER>ET_ANSWER</PARAMETER>
       <TYP>ZCL_ALLOC_ALT_API=&gt;TY_ANSWER_TAB</TYP>
      </RSEXP>
     </EXPORT>
    </item>
