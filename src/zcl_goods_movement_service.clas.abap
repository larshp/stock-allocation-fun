        ENDIF.
      ENDIF.
    ENDLOOP.

    IF rs_result-stopped_on_failure = abap_true.
      LOOP AT rs_result-movements ASSIGNING <ls_movement>
          WHERE is_attempted = abap_false.
        <ls_movement>-is_skipped = abap_true.
        ADD 1 TO rs_result-skipped_count.
      ENDLOOP.
    ENDIF.
