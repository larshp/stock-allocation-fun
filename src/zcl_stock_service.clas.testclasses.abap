            ( request_id = 'UNKNOWN' storage_location = '0002'
              priority_rank          = 1 ) ) ).
      CATCH zcx_invalid_stock_request.
        lv_rejected                  = abap_true.
    ENDTRY.
    cl_abap_unit_assert=>assert_equals(
      exp = abap_true
      act = lv_rejected ).
