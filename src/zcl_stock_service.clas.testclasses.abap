      exp = 'EARLY'
      act = lt_allocations[ 2 ]-request_id ).
    cl_abap_unit_assert=>assert_equals(
      exp = CONV mard-labst( '3.000' )
      act = lt_allocations[ 2 ]-allocated_quantity ).
