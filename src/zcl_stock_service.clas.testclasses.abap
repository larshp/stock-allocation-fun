    lo_repository->set_location_stocks(
      it_stock = VALUE #(
        ( storage_location   = '0001'
          available_quantity = '2.000' )
        ( storage_location   = '0002'
          available_quantity = '3.000' )
        ( storage_location   = '0003'
          available_quantity = '4.000' ) ) ).
