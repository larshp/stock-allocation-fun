      exp = CONV mard-labst( '2.000' )
      act = ls_result-plant_allocations[ 2 ]-allocated_quantity ).
    cl_abap_unit_assert=>assert_equals(
      exp = 'REQ-2'
      act = ls_result-plant_allocations[ 3 ]-request_id ).
    cl_abap_unit_assert=>assert_equals(
      exp = CONV mard-labst( '1.000' )
