      lv_internal_request_id = |P{ lv_internal_index }|.
      APPEND VALUE #(
        request_id              = lv_internal_request_id
        priority                = ls_demand-priority
        wbs_element             = ls_demand-wbs_element
        material                = ls_demand-material
