        entry_unit_iso   = ls_material_unit-base_unit_iso
        batch            = ls_request-batch
        valuation_type   = ls_request-valuation_type )
        TO lt_movement_items.
    ENDLOOP.

    rs_result = execute(
      is_header   = is_header
