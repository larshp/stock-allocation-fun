          plant           = '1000'
          base_unit       = 'EA'
          receipt_date    = '20261225'
          quantity        = '5.000'
          source_type     = 'PO_CONFIRMATION'
          source_document = '4500000010' ) ) ).
    DATA(lo_cut) = NEW zcl_stock_service(
      io_stock_repository = lo_repository ).

